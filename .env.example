# Server Configuration
PORT=8000
HOST=0.0.0.0
TICKETS_DATA_PATH=data/tickets_sample.csv
OPS_TRACKING_PATH=data/ops_tracking_sheet.csv
BASE_URL=https://ticket-api-jl9f.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ticket-triage-frontend.onrender.com

# Ops Notifications
ESCALATION_EMAIL=manager@example.com
ESCALATION_MANAGER_EMAIL=manager@example.com
AGENT_NOTIFICATIONS_EMAIL=agent@example.com

# Google Gemini API Key (Required for live AI triage)
GEMINI_API_KEY=mock_gemini_api_key_placeholder
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=10000

# Live SMTP Relay Configuration (Optional: mock mode used if unconfigured)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=mock_notifications@example.com
SMTP_PASSWORD=mock_smtp_password_placeholder
SMTP_FROM=Billing Ops <notifications@example.com>
# HTTP Email Providers (Recommended for Render Free Tier to bypass SMTP port blocks)
RESEND_API_KEY=re_mock_123456789_placeholder
RESEND_FROM=onboarding@resend.dev
BREVO_API_KEY=xkeysib_mock_123456789_placeholder
BREVO_FROM=alerts@example.com
EMAIL_WEBHOOK_URL=https://example.com/api/email-webhook

